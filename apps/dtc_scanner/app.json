{
  "id": "dtc_scanner",
  "title": "Fault Scanner",
  "description": "Read and clear fault memory of every control unit, what each unit kept about a fault, how fast units answer, plus active Check Control messages and values that do not fit together or arrive late",
  "version": "2.15.1",
  "vendor": "custom",
  "loggingId": "OA95",
  "iconGlyph": "engine",
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.18", "mgu-inputgate": "1.1.0" },
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
      "basicList": "rs"
    },
    "de.bmw.infotainment.KombiInterface_2": {
      "ccList": "rs",
      "newCCMessage": "rs",
      "cbsDataServiceList": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "the health report's 12 V charge, oil and coolant, and the Plausibility tab's rpm and temperatures",
      "statusBattery2": "rs",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the Plausibility tab's speed",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "the Plausibility tab's forward g",
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the Plausibility tab's outside temperature",
      "ExteriorTemperature": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Fault Scanner",
      "buttons": [
        ["BTN_SCAN", "Scan now"],
        ["BTN_CLEAR", "Clear all"],
        ["BTN_DETAIL", "Fault details"],
        ["BTN_PAGE", "Next page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "scope", "label": "Faults to read", "type": "choice", "default": "current",
     "options": [["current", "Current"], ["all", "Incl. history"]]},
    {"key": "info", "label": "Also read info memory", "type": "bool", "default": false},
    {"key": "autoScan", "label": "Scan when opened", "type": "bool", "default": true},
    {"key": "plausibility", "label": "Plausibility checks", "type": "bool", "default": true},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
