{
  "id": "gforce",
  "title": "G-Force",
  "description": "Friction circle with grip envelope, peak g per direction and session records, and the last minute of driving saved when it matters, with replay",
  "version": "1.7.1",
  "vendor": "custom",
  "loggingId": "OA9B",
  "iconGlyph": "gforce",
  "autostart": true,
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.15" },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "torque (a recording at full power) and the driving mode (Sport stretches)",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "G-Force",
      "buttons": [
        ["BTN_ACTION", "Reset max"],
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_PLAY", "Play / Pause"],
        ["BTN_RATE", "Replay speed"],
        ["BTN_START", "Back to start"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "scale", "label": "Circle size", "type": "number", "unit": "g", "default": 1.5, "steps": [1.0, 1.5, 2.0]},
    {"key": "trail", "label": "Trail length", "type": "number", "unit": "s", "default": 4, "steps": [2, 4, 8, 15]},
    {"key": "flipLat", "label": "Swap left / right", "type": "bool", "default": false},
    {"key": "flipLong", "label": "Swap accel / brake (brake on top)", "type": "bool", "default": false},
    {"key": "speedUnit", "label": "Speed unit", "type": "choice", "default": "kmh", "options": [["kmh", "km/h"], ["mph", "mph"]]},
    {"key": "bbRecord", "label": "Save the last minute", "type": "bool", "default": false},
    {"key": "bbBrake", "label": "Save on a hard stop", "type": "bool", "default": true, "when": {"bbRecord": true}},
    {"key": "bbBrakeG", "label": "Hard stop from", "type": "number", "unit": "g", "default": 0.7, "steps": [0.5, 0.6, 0.7, 0.8, 0.9, 1.0], "when": {"bbRecord": true}},
    {"key": "bbPower", "label": "Save at full power", "type": "bool", "default": false, "when": {"bbRecord": true}},
    {"key": "bbSport", "label": "Record every Sport stretch", "type": "bool", "default": false, "when": {"bbRecord": true}},
    {"key": "bbKeep", "label": "Recordings kept", "type": "number", "default": 30, "steps": [10, 20, 30, 50], "when": {"bbRecord": true}},
    {"key": "bbPeakKw", "label": "Most power seen", "type": "number", "unit": "kW", "default": 0, "hidden": true},
    {"key": "advanced", "label": "Advanced settings", "type": "bool", "default": false},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "gRate", "label": "G-force display rate", "type": "number", "unit": "fps", "default": 10, "markDefault": true, "steps": [5, 10, 15, 30, 60], "when": {"advanced": true}},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
