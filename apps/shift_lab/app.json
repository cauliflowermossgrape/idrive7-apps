{
  "id": "shift_lab",
  "title": "Shift Lab",
  "description": "Every upshift under load measured: how long it took, the rpm drop and the g dip; each gear's ratio, how hard the car pulls in each gear, how fast it kicks down when you floor it, and cold against warm gearbox",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAAA",
  "iconGlyph": "rpm",
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.15" },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the gear (else learned from the rpm and speed)",
      "statusGearboxDrive": "rs",
      "DataPowerTrain2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "engine torque (what counts as under load) and the driving mode (kickdowns per mode)",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "_optional": "the accelerator pedal (kickdowns; without it the engine torque stands in, as an estimate)",
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "the gearbox oil temperature (Cold vs hot)",
      "basicDataSet": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Shift Lab",
      "buttons": [
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_CLEAR", "Clear shifts"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "minTorque", "label": "Under load from", "type": "number", "unit": "Nm", "default": 150, "steps": [80, 100, 150, 200, 300]},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
