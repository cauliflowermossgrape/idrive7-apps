{
  "id": "redline",
  "title": "Redline",
  "description": "Full-screen rev tach with shift lights, gear, shift scoring and cold-engine rev guard",
  "version": "1.22.0",
  "vendor": "custom",
  "loggingId": "OA97",
  "iconGlyph": "rpm",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "engine torque (per-gear shift points) and boost (HUD)",
      "statusActualValueTorque2": "rs",
      "statusSwitchDriveDynamicSport2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusVehiclePartType": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature on the HUD when the gearbox unit doesn't answer",
      "basicDataSet": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Redline",
      "buttons": [
        ["BTN_RESET", "Reset max"],
        ["BTN_RESET_LEARNED", "Reset learned"],
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "engine", "label": "Engine", "type": "choice", "default": "auto",
     "options": [["auto", "Auto (from the car)"], ["diesel", "Diesel"], ["petrol", "Petrol"]]},
    {"key": "redline", "label": "Redline", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Auto"}, "reset": 1,
     "steps": [0, 4000, 4500, 5000, 5500, 5800, 6000, 6200, 6500, 6800, 7000, 7200, 7500, 7800, 8000, 8500, 9000]},
    {"key": "learn", "label": "Learn from driving (redline, shift points, reaction time)", "type": "bool", "default": true, "group": "Learning (experimental)"},
    {"key": "learnRedline", "label": "Learn redline from the limiter", "type": "bool", "default": true, "when": {"learn": true}, "group": "Learning (experimental)"},
    {"key": "rpmScale", "label": "Rev scale up to", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Auto"},
     "steps": [0, 5000, 6000, 7000, 8000, 9000, 10000]},
    {"key": "shiftMode", "label": "Shift point", "type": "choice", "default": "learned",
     "options": [["learned", "Per gear, learned (experimental)"], ["fixed", "Redline minus the setting below"]]},
    {"key": "minShift", "label": "Minimum shift point", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "None"},
     "steps": [0, 4000, 4500, 5000, 5500, 5800, 6000, 6200, 6500]},
    {"key": "shiftBefore", "label": "Shift point before redline", "type": "number", "unit": "rpm", "default": 300,
     "steps": [0, 100, 200, 300, 500, 800, 1000]},
    {"key": "hudLead", "label": "Shift lights early by (reaction time, experimental)", "type": "number", "unit": "ms", "default": -1, "reset": 1, "labels": {"-1": "Auto (learns from your shifts)"},
     "steps": [-1, 0, 100, 150, 200, 250, 300, 400]},
    {"key": "downCue", "label": "Downshift cue (experimental)", "type": "choice", "default": "slowing",
     "options": [["slowing", "While slowing down"], ["always", "Always"], ["off", "Off"]]},
    {"key": "lights", "label": "Shift light style", "type": "choice", "default": "m",
     "options": [["m", "M (green-yellow-red)"], ["f1", "Race (green-red-blue)"], ["mono", "Theme colour"]]},
    {"key": "flash", "label": "Blink and flash at shift point", "type": "bool", "default": false, "reset": 1},
    {"key": "coldGuard", "label": "Cold-engine rev guard", "type": "bool", "default": true},
    {"key": "coldLimit", "label": "Cold rev limit", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Auto"}, "reset": 1,
     "steps": [0, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 5500]},
    {"key": "warmOil", "label": "Oil warm at", "type": "number", "unit": "°C", "default": 80,
     "steps": [60, 70, 80, 90]},
    {"key": "speedUnit", "label": "Speed unit", "type": "choice", "default": "kmh",
     "options": [["kmh", "km/h"], ["mph", "mph"]]},
    {"key": "peakHold", "label": "Peak hold (0 = until reset)", "type": "number", "unit": "s", "default": 15,
     "steps": [0, 5, 10, 15, 30, 60]},
    {"key": "hud", "label": "Show on HUD (experimental)", "type": "choice", "default": "off",
     "options": [["off", "Off"], ["on", "On"], ["test", "Test pattern"]]},
    {"key": "hudStyle", "label": "Layout", "type": "choice", "default": "standard", "when": {"hud": ["on", "test"]}, "group": "HUD style",
     "options": [["standard", "Standard"], ["minimal", "Minimal (lights and gear)"], ["wings", "Split wings"], ["digital", "80s digital dash"], ["vfd", "VFD glow (teal)"], ["vector", "Vector arcade (outlines)"]]},
    {"key": "hudPalette", "label": "Colours", "type": "choice", "default": "colour", "when": {"hud": ["on", "test"], "hudStyle": ["standard", "minimal", "wings", "digital", "vector"]}, "group": "HUD style",
     "options": [["colour", "Colour"], ["amber", "Night amber"], ["ice", "Ice white"]]},
    {"key": "hudLightStyle", "label": "Shift lights", "type": "choice", "default": "gt3", "when": {"hud": ["on", "test"]}, "group": "HUD style",
     "options": [["gt3", "GT3 (outside in, flash)"], ["bar", "Left to right"], ["off", "Off"]]},
    {"key": "hudContent", "label": "Shows", "type": "choice", "default": "all", "when": {"hud": ["on", "test"]}, "group": "HUD style",
     "options": [["all", "Tach, gear and temperatures"], ["gear", "Tach and gear"], ["temps", "Tach and temperatures"], ["tach", "Tach only"]]},
    {"key": "hudTempsMode", "label": "Temperatures", "type": "choice", "default": "smart", "when": {"hud": ["on", "test"], "hudContent": ["all", "temps"]}, "group": "HUD style",
     "options": [["smart", "Only when cold or hot"], ["always", "Always"]]},
    {"key": "hudBoost", "label": "Boost", "type": "bool", "default": true, "when": {"hud": ["on", "test"]}, "group": "HUD style"},
    {"key": "hudChip", "label": "Shift grade after each upshift", "type": "choice", "default": "burst", "when": {"hud": ["on", "test"]}, "group": "HUD style",
     "aliases": {"true": "burst", "false": "off"},
     "options": [["burst", "Burst (pops, ring)"], ["simple", "Simple"], ["off", "Off"]]},
    {"key": "hudPeak", "label": "Peak marker", "type": "bool", "default": true, "when": {"hud": ["on", "test"]}, "group": "HUD style"},
    {"key": "hudShake", "label": "Shake on the limiter", "type": "bool", "default": false, "when": {"hud": ["on", "test"]}, "group": "HUD style"},
    {"key": "hudUnlit", "label": "Unlit segments", "type": "choice", "default": "dim", "when": {"hud": ["on", "test"]}, "group": "HUD style",
     "options": [["dim", "Dim"], ["hidden", "Hidden"]]},
    {"key": "hudSize", "label": "Size", "type": "number", "unit": "%", "default": 100, "when": {"hud": ["on", "test"]}, "group": "HUD position and size",
     "steps": [70, 80, 90, 100, 110, 120, 130]},
    {"key": "hudX", "label": "Position left / right", "type": "number", "unit": "px", "default": 0, "labels": {"0": "Centre"}, "when": {"hud": ["on", "test"]}, "group": "HUD position and size",
     "steps": [-120, -100, -80, -60, -40, -20, 0, 20, 40, 60, 80, 100, 120]},
    {"key": "hudY", "label": "Position up / down", "type": "number", "unit": "px", "default": 0, "labels": {"0": "Default"}, "when": {"hud": ["on", "test"]}, "group": "HUD position and size",
     "steps": [-40, -30, -20, -10, 0, 10, 20, 30, 40, 50, 60]},
    {"key": "hudFps", "label": "Frame rate", "type": "number", "unit": "fps", "default": 20, "when": {"hud": ["on", "test"]}, "group": "HUD position and size",
     "steps": [10, 20, 30]},
    {"key": "advanced", "label": "Advanced settings", "type": "bool", "default": false},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "speedRate", "label": "Speed display rate", "type": "number", "unit": "fps", "default": 10, "reset": 1, "markDefault": true, "steps": [5, 10, 15, 30, 60], "when": {"advanced": true}},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
