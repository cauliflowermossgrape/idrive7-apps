{
  "id": "exterior_lights",
  "title": "Exterior Lights",
  "description": "A light show and dark headlights for private ground and car meets, parked only, with a safety note and checks; explains the options that need coding",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OAAB",
  "iconGlyph": "ambient",
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.18" },
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left stops everything",
      "VehicleCondition": "s",
      "vehicleConditionNoCrc": "s"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "an open door stops everything",
      "CentralLockingSystemAndPanelStatus": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "the 12 V battery's charge",
      "statusBattery2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Exterior Lights",
      "buttons": [
        ["BTN_STOP", "STOP"],
        ["BTN_PLAY", "Play show"],
        ["BTN_NEXT", "Next show"],
        ["BTN_STEALTH", "Stealth"],
        ["BTN_ACCEPT", "Accept note"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "accepted", "label": "Safety note accepted", "type": "bool", "default": false},
    {"key": "minBattery", "label": "Stop below this 12 V charge", "type": "number", "unit": "%", "default": 50, "steps": [40, 50, 60, 70]},
    {"key": "stealthMin", "label": "Stealth at most", "type": "number", "unit": "min", "default": 5, "steps": [1, 5, 10]},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
