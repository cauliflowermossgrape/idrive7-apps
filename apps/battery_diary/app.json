{
  "id": "battery_diary",
  "title": "Battery Diary",
  "description": "The 12 V battery at every start: resting voltage, the dip while starting, charging, the last 60 starts with a trend",
  "version": "0.1.0",
  "vendor": "custom",
  "autostart": true,
  "loggingId": "OAAD",
  "iconGlyph": "battery",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusBattery2": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: no more reads, it can sleep",
      "VehicleCondition": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Battery Diary",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ],
  "config": {
    "comment": "battery.v12: the 12 V voltage candidates, copied as they are from eDrive's app.json (config.battery.v12); the first that answers is kept",
    "battery": {
      "v12": [
        {
          "ecu": 18,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 7,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 18,
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "the same PID with OBD service 01, for engine units that refuse F442 with NRC 31"
        },
        {
          "ecu": 19,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "second engine unit (0x13), on cars that have one"
        },
        {
          "ecu": 19,
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 24,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "transmission unit EGS (0x18): control module voltage too, when the engine unit doesn't answer (e.g. G06 N63)"
        },
        {
          "ecu": 24,
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 18,
          "did": "402B",
          "bytes": 2,
          "at": 2,
          "factor": 0.00025,
          "offset": 6,
          "min": 5,
          "max": 18,
          "note": "the battery sensor (IBS) itself; a G20 320i's engine unit answers all FF (out of range): then the ones above"
        },
        {
          "ecu": 18,
          "did": "5853",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "battery voltage from the battery sensor, 1 mV (seen on F32 DMEs)"
        },
        {
          "ecu": 64,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "body domain controller BDC (0x40), not yet confirmed on a car"
        },
        {
          "ecu": 26,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "electric drive unit EME (0x1A, holds the DC/DC converter on fully electric cars), not yet confirmed on a car"
        }
      ]
    }
  }
}
