{
  "id": "warmup",
  "title": "Warm-Up",
  "description": "Oil and coolant warm-up calculator (time to ready), ready for harder driving, safe rev limit, turbo cool-down, a cold start counter, and each drive summed up, compared and before / after a change",
  "version": "1.12.1",
  "vendor": "custom",
  "loggingId": "OA9A",
  "iconGlyph": "temp",
  "autostart": true,
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.15" },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusBattery2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "g forward and sideways, for each drive's summary",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "the odometer (each drive's km), range and fuel (Ready?)",
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the outside temperature (Ready?)",
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "tyre pressures and their targets (Ready?)",
      "statusTyrePressure": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusVehiclePartType": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature (when the gearbox unit has none)",
      "basicDataSet": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "startWidget": {
    "comment": "Home-screen widget, as eDrive's: the layout and cell names of BMW's Drive Recorder widget on this firmware; the picture goes into BackgroundImage1 (384 x 256), scaled up and cropped centred by the HMI (safe), the edges faded: the setting widgetFit keeps the content further in. The small widget gets text lines and the progress bar instead.",
    "name": "Warm-Up",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "scale": 2,
    "size": [
      384,
      256
    ],
    "safe": [
      0.09,
      0.17
    ],
    "cells": {
      "ErrorInfo": [
        false,
        "Bool"
      ],
      "background": [
        true,
        "Bool"
      ],
      "ProgressbarVisible": [
        false,
        "Bool"
      ],
      "TextRecordings": [
        "",
        "Text"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Warm-Up",
      "buttons": [
        ["BTN_PREV", "Previous"],
        ["BTN_NEXT", "Next"],
        ["BTN_VIEW", "Drives view"],
        ["BTN_MARK", "Mark a change"],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "warmOil",
      "label": "Oil is warm at",
      "type": "number",
      "unit": "°C",
      "unitBy": "tempUnit",
      "units": { "f": { "unit": "°F", "mul": 1.8, "add": 32 } },
      "default": 80,
      "steps": [
        60,
        70,
        75,
        80,
        85,
        90,
        100
      ]
    },
    {
      "key": "warmCoolant",
      "label": "Coolant is warm at",
      "type": "number",
      "unit": "°C",
      "unitBy": "tempUnit",
      "units": { "f": { "unit": "°F", "mul": 1.8, "add": 32 } },
      "default": 80,
      "steps": [
        60,
        70,
        75,
        80,
        85,
        90
      ]
    },
    {
      "key": "warmGearbox",
      "label": "Gearbox oil is warm at",
      "type": "number",
      "unit": "°C",
      "unitBy": "tempUnit",
      "units": { "f": { "unit": "°F", "mul": 1.8, "add": 32 } },
      "default": 60,
      "steps": [40, 50, 60, 70, 80]
    },
    {
      "key": "engine",
      "label": "Engine",
      "type": "choice",
      "default": "auto",
      "options": [
        ["auto", "Auto (from the car)"],
        ["diesel", "Diesel"],
        ["petrol", "Petrol"]
      ]
    },
    {
      "key": "coldLimit",
      "label": "Rev limit when cold",
      "type": "number",
      "unit": "rpm",
      "default": 0,
      "labels": {"0": "Auto"},
      "reset": 1,
      "steps": [
        0,
        2000,
        2500,
        3000,
        3500,
        4000,
        4500,
        5000,
        5500
      ]
    },
    {
      "key": "redline",
      "label": "Redline",
      "type": "number",
      "unit": "rpm",
      "default": 0,
      "labels": {"0": "Auto"},
      "reset": 1,
      "steps": [
        0,
        4000,
        4500,
        5000,
        5500,
        5800,
        6000,
        6200,
        6500,
        6800,
        7000,
        7200,
        7500,
        7800,
        8000,
        8500,
        9000
      ]
    },
    {
      "key": "cooldown",
      "label": "Turbo cool-down after hard driving",
      "type": "bool",
      "default": true
    },
    {
      "key": "driveCsv",
      "label": "Record a CSV of each drive",
      "type": "bool",
      "default": false
    },
    {"key": "compareWith", "label": "Compare a drive with", "type": "choice", "default": "prev",
     "options": [["prev", "The drive before"], ["avg10", "The average of the 10 before it"]]},
    {"key": "markLabel", "label": "Change to mark", "type": "choice", "default": "Service",
     "options": [["Service", "Service"], ["New part", "New part"], ["Tyres", "Tyres"], ["Setting change", "Setting change"], ["Fuel brand", "Fuel brand"], ["Other", "Other"]]},
    {"key": "compareKind", "label": "Before / After compares", "type": "choice", "default": "all",
     "options": [["all", "All drives"], ["length", "Drives of a similar length"], ["speed", "Drives of a similar average speed"]]},
    {"key": "widgetFit", "label": "Home-screen widget: picture", "type": "choice", "default": "large", "options": [["small", "Small, clear of the edges"], ["medium", "Medium"], ["large", "Fill the widget"]]},
    {
      "key": "tempUnit",
      "label": "Temperature unit",
      "type": "choice",
      "default": "c",
      "options": [
        [
          "c",
          "Celsius"
        ],
        [
          "f",
          "Fahrenheit"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ]
}
