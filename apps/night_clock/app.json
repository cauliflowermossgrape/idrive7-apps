{
  "id": "night_clock",
  "title": "Night Clock",
  "description": "One quiet screen for night driving or waiting: the time large and dim on black, the outside temperature and speed if wanted, and a standby row with the 12 V charge and the range",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "24",
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.18" },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the outside temperature under the time",
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "the 12 V charge in the status row",
      "statusBattery2": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "the range in the status row",
      "statusRangeTankStatus": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Night Clock",
      "buttons": [
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "brightness", "label": "Brightness of the figures", "type": "number", "unit": "%", "default": 40, "steps": [15, 25, 40, 60, 80, 100]},
    {"key": "tint", "label": "Colour", "type": "choice", "default": "white",
     "options": [["white", "White"], ["red", "Red (keeps night vision)"], ["amber", "Amber"], ["blue", "Blue"]]},
    {"key": "format", "label": "Clock", "type": "choice", "default": "24", "options": [["24", "24 hours"], ["12", "12 hours"]]},
    {"key": "seconds", "label": "Show seconds (else a blinking colon)", "type": "bool", "default": false},
    {"key": "outside", "label": "Outside temperature", "type": "bool", "default": true},
    {"key": "speed", "label": "Speed", "type": "bool", "default": false},
    {"key": "status", "label": "Status row (outside, 12 V battery, range)", "type": "bool", "default": true},
    {"key": "tempUnit", "label": "Temperature unit", "type": "choice", "default": "c", "options": [["c", "Celsius"], ["f", "Fahrenheit"]]},
    {"key": "speedUnit", "label": "Speed unit", "type": "choice", "default": "kmh", "options": [["kmh", "km/h"], ["mph", "mph"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
