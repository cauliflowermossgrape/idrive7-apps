{
  "id": "m_drive",
  "title": "M Drive",
  "description": "M Drive for BMW MGU ID7: engine speed, engine oil, coolant, gearbox oil, intake air and boost at a glance, with the MHD tune's map 1-4, the exhaust flap and Max Cooling. Opening it only reads; nothing is sent to the car unless Settings > Car controls is On, never with demo data",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OAA3",
  "iconGlyph": "rpm",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "sharedSources": [
    "apps/live_adjustments/tune.js",
    "apps/live_adjustments/controller.js",
    "apps/live_adjustments/auto.js",
    "apps/live_adjustments/diaglink.js",
    "apps/live_adjustments/adapters.js",
    "apps/live_adjustments/real_adapters.js",
    "apps/live_adjustments/bm3_protocol.js",
    "apps/live_adjustments/bm3_profiles.js"
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature from the car's data set; the gearbox unit is read instead",
      "basicDataSet": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "M Drive",
      "buttons": [
        [
          "BTN_MAP1",
          "Map 1"
        ],
        [
          "BTN_MAP2",
          "Map 2"
        ],
        [
          "BTN_MAP3",
          "Map 3"
        ],
        [
          "BTN_MAP4",
          "Map 4"
        ],
        [
          "BTN_FLAP_OEM",
          "Flap OEM"
        ],
        [
          "BTN_FLAP_OPEN",
          "Flap open"
        ],
        [
          "BTN_FLAP_CLOSED",
          "Flap closed"
        ],
        [
          "BTN_COOL_ON",
          "Max Cooling on"
        ],
        [
          "BTN_COOL_OFF",
          "Max Cooling off"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "controls",
      "label": "Car controls",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off · nothing is sent to the car (safe)"
        ],
        [
          "on",
          "On · MHD map, exhaust flap, Max Cooling"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ],
