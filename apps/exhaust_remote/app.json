{
  "id": "exhaust_remote",
  "title": "Exhaust Remote",
  "description": "Exhaust Remote for BMW MGU ID7: the exhaust flap (OEM, Open, Close over the car's own diagnostic link) on a picture of the rear silencer, with Drive mode (Sport open, Comfort OEM, Eco Pro closed), hold, a Close rpm limit and a no-rpm fail-safe. Same flap control as Engine Config",
  "version": "1.4.2",
  "vendor": "custom",
  "loggingId": "OAA3",
  "iconGlyph": "sliders",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Exhaust Remote",
      "buttons": [
        [
          "BTN_OPEN",
          "Open"
        ],
        [
          "BTN_CLOSE",
          "Close"
        ],
        [
          "BTN_OEM",
          "OEM"
        ],
        [
          "BTN_DRIVE",
          "Drive mode"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "arm",
      "label": "Exhaust Flap",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed · simulated (safe)"
        ],
        [
          "on",
          "Armed · actuates the real valve"
        ]
      ]
    },
    {
      "key": "hold",
      "label": "Hold Open / Close",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "On · sent again every 15 s"
        ],
        [
          "off",
          "Off · the car takes over after ~20 s"
        ]
      ]
    },
    {
      "key": "closeLimit",
      "label": "Close: hand back above",
      "type": "choice",
      "default": "4000",
      "options": [
        [
          "2500",
          "2,500 rpm"
        ],
        [
          "3000",
          "3,000 rpm"
        ],
        [
          "3500",
          "3,500 rpm"
        ],
        [
          "4000",
          "4,000 rpm"
        ],
        [
