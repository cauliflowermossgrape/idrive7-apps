        ],
        [
          "5000",
          "5,000 rpm"
        ],
        [
          "5500",
          "5,500 rpm"
        ],
        [
          "off",
          "Never (not recommended)"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
