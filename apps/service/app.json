{
  "id": "service",
  "title": "Service",
  "description": "Service requirements from the instrument cluster: oil, brakes, brake fluid, vehicle check, inspection - distance, date, details; brake fluid and vehicle check reset; your own intervals, wheels, the 12 V battery, refuels, parts and milestones",
  "version": "1.7.1",
  "vendor": "custom",
  "loggingId": "OA96",
  "iconGlyph": "wrench",
  "autostart": true,
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.15" },
  "signals": {
    "de.bmw.infotainment.KombiInterface_2": {
      "cbsDataServiceList": "rs",
      "cbsDataSBA": "rs",
      "_methods": ["requestCBSServiceHint"]
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "the odometer, tank and range for your own intervals, Wheels and Garage (Fuel)",
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "rpm and oil temperature for the drives (wear estimate) and the starts (Battery), the 12 V charge",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusBattery2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the drives (wear estimate) and refuels while parked",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "hard stops for the wear estimate",
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "power, for the high load part of the wear estimate",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: no more reads, it can sleep",
      "VehicleCondition": "s"
    }
  },
  "config": {
    "comment": "battery.v12: the 12 V voltage candidates for the Battery page, copied as they are from eDrive's app.json (config.battery.v12); the first that answers is kept",
    "battery": {
      "v12": [
        {
          "ecu": 18,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 7,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 18,
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "the same PID with OBD service 01, for engine units that refuse F442 with NRC 31"
        },
        {
          "ecu": 19,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "second engine unit (0x13), on cars that have one"
        },
        {
          "ecu": 19,
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 24,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "transmission unit EGS (0x18): control module voltage too, when the engine unit doesn't answer (e.g. G06 N63)"
        },
        {
          "ecu": 24,
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        },
        {
          "ecu": 18,
          "did": "402B",
          "bytes": 2,
          "at": 2,
          "factor": 0.00025,
          "offset": 6,
          "min": 5,
          "max": 18,
          "note": "the battery sensor (IBS) itself; a G20 320i's engine unit answers all FF (out of range): then the ones above"
        },
        {
          "ecu": 18,
          "did": "5853",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "battery voltage from the battery sensor, 1 mV (seen on F32 DMEs)"
        },
        {
          "ecu": 64,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "body domain controller BDC (0x40), not yet confirmed on a car"
        },
        {
          "ecu": 26,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18,
          "note": "electric drive unit EME (0x1A, holds the DC/DC converter on fully electric cars), not yet confirmed on a car"
        }
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Service",
      "buttons": [
        ["BTN_SELECT", "Next item"],
        ["BTN_DETAILS", "Details"],
        ["BTN_RESET", "Reset service"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "resetOn", "label": "Service reset (brake fluid, vehicle check)", "type": "bool", "default": false},
    {"key": "diagPage", "label": "Diagnostics page", "type": "bool", "default": false},
    {"key": "oilKm", "label": "Engine oil every", "type": "number", "unit": "km", "default": 10000, "labels": {"0": "Off"}, "steps": [0, 5000, 7000, 8000, 10000, 12000, 15000]},
    {"key": "plugsKm", "label": "Spark plugs every", "type": "number", "unit": "km", "default": 60000, "labels": {"0": "Off"}, "steps": [0, 20000, 30000, 40000, 60000, 80000, 100000]},
    {"key": "gearboxKm", "label": "Gearbox oil every", "type": "number", "unit": "km", "default": 80000, "labels": {"0": "Off"}, "steps": [0, 40000, 60000, 80000, 100000, 120000]},
    {"key": "padsFrontKm", "label": "Brake pads front every", "type": "number", "unit": "km", "default": 40000, "labels": {"0": "Off"}, "steps": [0, 20000, 30000, 40000, 50000, 60000]},
    {"key": "padsRearKm", "label": "Brake pads rear every", "type": "number", "unit": "km", "default": 50000, "labels": {"0": "Off"}, "steps": [0, 30000, 40000, 50000, 60000, 80000]},
    {"key": "airFilterKm", "label": "Air filter every", "type": "number", "unit": "km", "default": 0, "labels": {"0": "Off"}, "steps": [0, 20000, 30000, 40000, 60000]},
    {"key": "cabinFilterKm", "label": "Cabin filter every", "type": "number", "unit": "km", "default": 0, "labels": {"0": "Off"}, "steps": [0, 10000, 15000, 20000, 30000]},
    {"key": "brakeFluidMonths", "label": "Brake fluid every", "type": "number", "unit": "months", "default": 24, "labels": {"0": "Off"}, "steps": [0, 12, 24, 36]},
    {"key": "wheelSets", "label": "Wheel sets", "type": "choice", "default": "two", "options": [["two", "Summer and winter"], ["three", "Summer, winter and all-season"]]},
    {"key": "treadSummer", "label": "Summer tyres tread", "type": "number", "unit": "mm", "default": 0, "labels": {"0": "Not measured"}, "steps": [0, 2, 3, 4, 5, 6, 7, 8]},
    {"key": "treadWinter", "label": "Winter tyres tread", "type": "number", "unit": "mm", "default": 0, "labels": {"0": "Not measured"}, "steps": [0, 2, 3, 4, 5, 6, 7, 8, 9]},
    {"key": "treadAll", "label": "All-season tyres tread", "type": "number", "unit": "mm", "default": 0, "labels": {"0": "Not measured"}, "steps": [0, 2, 3, 4, 5, 6, 7, 8]},
    {"key": "fuelBrand", "label": "Fuel station (next refuel)", "type": "choice", "default": "none", "options": [["none", "Not noted"], ["usual", "My usual station"], ["second", "Another station"], ["other", "Other"]]},
    {"key": "octane", "label": "Octane (next refuel)", "type": "number", "default": 0, "labels": {"0": "Not noted"}, "steps": [0, 91, 95, 98, 100]},
    {"key": "partType", "label": "Noted in Garage (a part or care)", "type": "choice", "default": "Oil and filter", "options": [["Oil and filter", "Oil and filter"], ["Spark plugs", "Spark plugs"], ["Brake pads", "Brake pads"], ["Brake discs", "Brake discs"], ["Tyres", "Tyres"], ["Battery", "Battery"], ["Air filter", "Air filter"], ["Cabin filter", "Cabin filter"], ["Intake", "Intake"], ["Exhaust", "Exhaust"], ["Suspension", "Suspension"], ["Tune / map", "Tune / map"], ["Wheels", "Wheels"], ["Care", "Care (wash, wax, ...)"], ["Other", "Other"]]},
    {"key": "batteryRead", "label": "Battery: read the 12 V voltage", "type": "bool", "default": true},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour", "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full", "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto", "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto", "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
