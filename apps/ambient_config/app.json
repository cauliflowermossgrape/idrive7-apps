{
  "id": "ambient_config",
  "title": "Ambient config",
  "description": "Any colour on the ambient light, animations, and a look for each driving mode",
  "version": "2.1.5",
  "vendor": "custom",
  "loggingId": "OAA4",
  "iconGlyph": "ambient",
  "autostart": true,
  "signals": {
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "ambientLightInteriorColour": "w",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the driving mode: colours by mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "day or night: dimmer at night",
      "statusDayNightChangeOver": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the car's own light",
      "VehicleCondition": "s"
    },
    "de.bmw.body.Light": {
      "_optional": "the turn signals: that side's lights breathe green",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "an open door: its lights red",
      "CentralLockingSystemAndPanelStatus": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the car's speed: driven (for a car that does not say it is locked and left)",
      "statusCarSpeed2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient config",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "carKind",
      "label": "Car type",
      "type": "choice",
      "default": "ice",
      "hidden": true,
      "options": [
        [
          "ice",
          "Petrol or diesel"
        ],
        [
          "hybrid",
          "Plug-in hybrid"
        ]
      ]
    },
    {
      "key": "follow",
      "label": "Look by driving mode",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "welcome",
      "label": "Welcome sweep at start",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "sportPulse",
      "label": "Sport pulse",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "nightDim",
      "label": "Dimmer at night",
      "type": "bool",
      "default": true
    },
    {
      "key": "keep",
      "label": "My colour back at each start",
      "type": "bool",
      "default": true
    },
    {
      "key": "flashAlerts",
      "label": "Redline shift flash",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "turnGlow",
      "label": "Turn signal glow",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "doorRed",
      "label": "Open door red",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "drive",
      "label": "Steering wheel",
      "type": "choice",
      "default": "lhd",
      "options": [
        [
          "lhd",
          "Left"
        ],
        [
          "rhd",
          "Right"
        ]
      ]
    }
  ]
}
